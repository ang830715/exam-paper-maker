\newcommand{\candidateboxes}[1]{%
  \begin{tikzpicture}[baseline=(boxbase.base),x=1mm,y=1mm]
    \node[inner sep=0pt,outer sep=0pt] (boxbase) at (0,6.25) {};
    \foreach \x in {0,...,#1} {
      \draw (\x*8.5,0) -- (\x*8.5,12.5);
    }
    \draw (0,0) rectangle (#1*8.5,12.5);
  \end{tikzpicture}%
}

